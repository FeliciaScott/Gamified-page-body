<script>
const themes = {
  forest: {
    bg:"#F7F5EC", surface:"#FFFFFF", ink:"#20352B",
    muted:"#65746A", primary:"#0F2C23", accent:"#A0B59A",
    highlight:"#B78B65", line:"#DDE4D9", soft:"#EAF0E7"
  },
  earth: {
    bg:"#F5EFE3", surface:"#FFFCF6", ink:"#30291F",
    muted:"#76695B", primary:"#193D2D", accent:"#D5B58A",
    highlight:"#785440", line:"#E1D4C2", soft:"#EAE2D4"
  },
  blue: {
    bg:"#F4F7FB", surface:"#FFFFFF", ink:"#24344A",
    muted:"#65748A", primary:"#172B4D", accent:"#A0C4DF",
    highlight:"#D49A3A", line:"#DCE5F0", soft:"#E6EFF8"
  },
  coral: {
    bg:"#FAF7F2", surface:"#FFFFFF", ink:"#242B31",
    muted:"#6C7378", primary:"#242B31", accent:"#A8B7B0",
    highlight:"#D97862", line:"#E5DFD8", soft:"#F1EAE4"
  }
};

document.querySelectorAll(".theme-btn").forEach(button => {
  button.addEventListener("click", () => {
    const theme = themes[button.dataset.theme];
    if (!theme) return;
    Object.entries(theme).forEach(([key, value]) => {
      document.documentElement.style.setProperty("--" + key, value);
    });
    document.querySelectorAll(".theme-btn").forEach(item => {
      item.setAttribute("aria-pressed", String(item === button));
    });
  });
});

document.getElementById("opportunity-search").addEventListener("submit", event => {
  event.preventDefault();
  const category = document.getElementById("category").value;
  const location = document.getElementById("location").value.trim();
  if (!location) return;
  const query = category + " in " + location;
  const link = "https://www.google.com/search?q=" + encodeURIComponent(query);
  const notice = document.getElementById("notice");
  notice.replaceChildren();
  const text = document.createElement("p");
  text.textContent = 'Your search is ready: "' + query + '".';
  const anchor = document.createElement("a");
  anchor.href = link;
  anchor.target = "_blank";
  anchor.rel = "noopener noreferrer";
  anchor.textContent = "Open search results →";
  notice.append(text, anchor);
  notice.style.display = "block";
});

document.getElementById("plan-form").addEventListener("submit", event => {
  event.preventDefault();
  const fields = [
    ["Goal", "goal"], ["Skill or gap", "skill"],
    ["First action", "action"], ["Target date", "deadline"]
  ];
  const output = document.getElementById("plan-output");
  output.replaceChildren();
  const heading = document.createElement("h3");
  heading.textContent = "Your draft career plan";
  output.appendChild(heading);
  fields.forEach(([label, id]) => {
    const p = document.createElement("p");
    const strong = document.createElement("strong");
    strong.textContent = label + ": ";
    p.append(strong, document.getElementById(id).value);
    output.appendChild(p);
  });
  const copy = document.createElement("button");
  copy.type = "button";
  copy.className = "btn btn-outline";
  copy.textContent = "Copy My Plan";
  copy.addEventListener("click", async () => {
    const text = fields.map(([label,id]) =>
      label + ": " + document.getElementById(id).value
    ).join("\n");
    try {
      await navigator.clipboard.writeText(text);
      copy.textContent = "Copied";
    } catch {
      copy.textContent = "Select and copy the plan text";
    }
  });
  output.appendChild(copy);
});

const checkboxes = [...document.querySelectorAll("#task-list input[type=checkbox]")];
function updateTasks() {
  const complete = checkboxes.filter(box => box.checked).length;
  document.getElementById("task-count").textContent =
    complete + " of " + checkboxes.length + " actions complete";
}
checkboxes.forEach(box => box.addEventListener("change", updateTasks));

document.getElementById("evidence").addEventListener("submit", event => {
  event.preventDefault();
  const fields = [
    ["Project or task","e-title"], ["Problem or objective","e-problem"],
    ["Work completed","e-work"], ["Result and evidence","e-result"]
  ];
  const output = document.getElementById("evidence-output");
  output.replaceChildren();
  const heading = document.createElement("h3");
  heading.textContent = "Evidence record";
  output.appendChild(heading);
  fields.forEach(([label,id]) => {
    const p = document.createElement("p");
    const strong = document.createElement("strong");
    strong.textContent = label + ": ";
    p.append(strong, document.getElementById(id).value);
    output.appendChild(p);
  });
  const copy = document.createElement("button");
  copy.type = "button";
  copy.className = "btn btn-outline";
  copy.textContent = "Copy Evidence Record";
  copy.addEventListener("click", async () => {
    const text = fields.map(([label,id]) =>
      label + ": " + document.getElementById(id).value
    ).join("\n\n");
    try {
      await navigator.clipboard.writeText(text);
      copy.textContent = "Copied";
    } catch {
      copy.textContent = "Select and copy the record text";
    }
  });
  output.appendChild(copy);
});
</script>
</body>
