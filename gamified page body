<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Elevate Learning Network | Career Quest</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

:root{
  --navy:#111936;
  --navy2:#202956;
  --cream:#f7f3e9;
  --gold:#d4af37;
  --gold2:#f0cf61;
  --green:#3fa66b;
  --red:#d85c5c;
  --white:#ffffff;
  --muted:#6b7280;
  --soft:#f1f3f7;
  --border:#e5e7eb;
  --shadow:0 12px 30px rgba(17,25,54,.10);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Inter,sans-serif;
}

body{
  background:var(--cream);
  color:var(--navy);
}

/* HEADER */

header{
  background:linear-gradient(135deg,var(--navy),var(--navy2));
  color:white;
  padding:16px 25px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:100;
  box-shadow:0 5px 20px rgba(0,0,0,.15);
}

.logo{
  font-weight:800;
  letter-spacing:.3px;
}

nav a{
  color:white;
  text-decoration:none;
  margin-left:20px;
  font-size:13px;
  opacity:.85;
}

nav a:hover{
  opacity:1;
}

/* LAYOUT */

.container{
  display:grid;
  grid-template-columns:280px minmax(350px,1fr) 300px;
  gap:18px;
  padding:20px;
  max-width:1500px;
  margin:auto;
}

/* CARDS */

.card{
  background:white;
  border-radius:16px;
  padding:18px;
  margin-bottom:18px;
  box-shadow:var(--shadow);
  border:1px solid rgba(0,0,0,.03);
}

.card h3{
  margin-bottom:12px;
}

/* PROFILE */

.avatar{
  width:60px;
  height:60px;
  border-radius:50%;
  background:linear-gradient(135deg,var(--gold),var(--gold2));
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:25px;
  margin-bottom:12px;
}

.level{
  font-weight:800;
  font-size:18px;
}

.badge{
  display:inline-block;
  margin-top:8px;
  padding:5px 10px;
  border-radius:20px;
  background:#fff4c9;
  color:#735a00;
  font-size:11px;
  font-weight:700;
}

.small{
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
}

/* XP */

.xp-info{
  display:flex;
  justify-content:space-between;
  margin-top:15px;
  font-size:12px;
  font-weight:700;
}

.bar{
  height:11px;
  background:#e9ebef;
  border-radius:20px;
  overflow:hidden;
  margin-top:7px;
}

.bar-fill{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,var(--gold),var(--gold2));
  transition:.5s ease;
}

/* STATS */

.stats{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
  margin-top:15px;
}

.stat{
  background:var(--soft);
  border-radius:10px;
  padding:10px;
  text-align:center;
}

.stat strong{
  display:block;
  font-size:18px;
}

/* QUESTS */

.quest{
  background:var(--soft);
  border:1px solid transparent;
  padding:14px;
  border-radius:12px;
  margin-top:10px;
  transition:.2s;
}

.quest:hover{
  transform:translateY(-2px);
  border-color:var(--gold);
}

.quest-title{
  font-weight:700;
  font-size:14px;
}

.quest-meta{
  display:flex;
  justify-content:space-between;
  margin-top:8px;
  align-items:center;
}

.xp{
  color:#8a6a00;
  font-weight:800;
  font-size:12px;
}

button{
  border:none;
  border-radius:8px;
  padding:8px 11px;
  cursor:pointer;
  font-weight:700;
  font-size:11px;
  background:var(--navy);
  color:white;
  transition:.2s;
}

button:hover{
  transform:translateY(-1px);
  background:var(--navy2);
}

button.gold{
  background:var(--gold);
  color:#201a00;
}

/* MISSION */

.hero{
  background:linear-gradient(135deg,#111936,#2b3569);
  color:white;
  border-radius:18px;
  padding:25px;
  margin-bottom:18px;
  position:relative;
  overflow:hidden;
}

.hero:after{
  content:"⚡";
  position:absolute;
  right:25px;
  top:20px;
  font-size:70px;
  opacity:.08;
}

.hero h1{
  font-size:25px;
  margin-bottom:7px;
}

.hero p{
  font-size:13px;
  opacity:.75;
  max-width:600px;
}

/* QUEST BOARD */

.quest-board{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
}

.mission{
  padding:16px;
  border:1px solid var(--border);
  border-radius:12px;
  position:relative;
}

.mission.completed{
  background:#eef9f2;
  border-color:#b7dfc6;
}

.mission-icon{
  font-size:25px;
  margin-bottom:8px;
}

.mission h4{
  margin-bottom:5px;
}

.mission p{
  font-size:12px;
  color:var(--muted);
  line-height:1.5;
}

.mission button{
  margin-top:12px;
}

/* SKILL TREE */

.skill{
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px;
  margin-top:9px;
  border-radius:10px;
  background:var(--soft);
}

.skill-icon{
  width:40px;
  height:40px;
  border-radius:10px;
  background:var(--navy);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
}

.skill.locked{
  opacity:.45;
}

.skill.unlocked{
  border:1px solid var(--gold);
}

/* PATHS */

.path{
  background:var(--soft);
  padding:13px;
  border-radius:11px;
  margin-top:9px;
  cursor:pointer;
  border:1px solid transparent;
  transition:.2s;
}

.path:hover{
  border-color:var(--gold);
  transform:translateY(-2px);
}

.path.selected{
  background:#fff7d7;
  border-color:var(--gold);
}

/* AI */

.ai{
  background:linear-gradient(135deg,#111936,#303a70);
  color:white;
}

.ai input{
  background:rgba(255,255,255,.1);
  color:white;
  border:1px solid rgba(255,255,255,.2);
}

.ai input::placeholder{
  color:#cbd0e0;
}

/* INPUT */

input,
textarea{
  width:100%;
  padding:10px;
  border:1px solid var(--border);
  border-radius:9px;
  margin-top:8px;
  outline:none;
}

textarea{
  min-height:100px;
  resize:vertical;
}

/* POSTS */

.post{
  padding:14px 0;
  border-bottom:1px solid var(--border);
}

.post:last-child{
  border-bottom:none;
}

/* ACHIEVEMENTS */

.achievement{
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px;
  background:var(--soft);
  border-radius:9px;
  margin-top:8px;
  font-size:12px;
}

.achievement.locked{
  opacity:.35;
}

/* NOTIFICATION */

#notification{
  position:fixed;
  right:20px;
  bottom:20px;
  background:var(--navy);
  color:white;
  padding:14px 18px;
  border-radius:12px;
  box-shadow:var(--shadow);
  opacity:0;
  transform:translateY(20px);
  pointer-events:none;
  transition:.3s;
  z-index:999;
}

#notification.show{
  opacity:1;
  transform:translateY(0);
}

/* RESET */

.reset{
  margin-top:10px;
  background:#eee;
  color:#555;
}

/* MOBILE */

@media(max-width:1100px){

  .container{
    grid-template-columns:1fr 1fr;
  }

  .container > div:nth-child(2){
    grid-column:span 2;
    grid-row:1;
  }

}

@media(max-width:750px){

  header{
    flex-direction:column;
    gap:10px;
  }

  .container{
    grid-template-columns:1fr;
  }

  .container > div:nth-child(2){
    grid-column:auto;
  }

  .quest-board{
    grid-template-columns:1fr;
  }

}

</style>
</head>

<body>

<header>

  <div class="logo">
    🏆 Elevate Learning Network
  </div>

  <nav>
    <a href="#missions">Missions</a>
    <a href="#skills">Skills</a>
    <a href="#feed">Community</a>
    <a href="#builder">Builder</a>
  </nav>

</header>


<div class="container">


<!-- LEFT -->

<div>

  <div class="card">

    <div class="avatar">🧠</div>

    <div class="level" id="levelBadge">
      Level 1 Learner
    </div>

    <div class="badge" id="rank">
      🥉 BEGINNER
    </div>

    <div class="xp-info">
      <span>XP</span>
      <span id="xpText">0 / 100 XP</span>
    </div>

    <div class="bar">
      <div class="bar-fill" id="xpBar"></div>
    </div>

    <div class="stats">

      <div class="stat">
        <strong id="streak">0</strong>
