<div id="notification"></div>


<script>

/* =========================
   GAME STATE
========================= */

let game = JSON.parse(
  localStorage.getItem("elevateGame")
) || {

  xp:0,
  streak:0,
  skillPoints:0,
  completed:[],
  missions:[],
  proofs:[],
  path:""

};


/* =========================
   LEVEL SYSTEM
========================= */

function level(){

  if(game.xp >= 1000) return 5;

  if(game.xp >= 600) return 4;

  if(game.xp >= 350) return 3;

  if(game.xp >= 150) return 2;

  return 1;

}


function levelName(){

  const names = {

    1:"🥉 BEGINNER",

    2:"🥈 EXPLORER",

    3:"🥇 BUILDER",

    4:"💎 STRATEGIST",

    5:"👑 OPPORTUNITY ARCHITECT"

  };

  return names[level()];

}


/* =========================
   SAVE
========================= */

function save(){

  localStorage.setItem(
    "elevateGame",
    JSON.stringify(game)
  );

}


/* =========================
   NOTIFICATION
========================= */

function notify(message){

  const box =
    document.getElementById("notification");

  box.innerText = message;

  box.classList.add("show");

  setTimeout(
    ()=>box.classList.remove("show"),
    2200
  );

}


/* =========================
   XP
========================= */

function addXP(amount){

  const oldLevel = level();

  game.xp += amount;

  game.skillPoints += Math.floor(amount / 25);

  const newLevel = level();

  if(newLevel > oldLevel){

    notify(
      "🎉 LEVEL UP! You reached Level "
      + newLevel + "!"
    );

  }else{

    notify("⭐ +" + amount + " XP");

  }

  save();

  update();

}


/* =========================
   UPDATE
========================= */

function update(){

  const lvl = level();

  const thresholds = {

    1:100,
    2:150,
    3:350,
    4:600,
    5:1000

  };

  let previous = 0;

  if(lvl === 2) previous = 100;
  if(lvl === 3) previous = 150;
  if(lvl === 4) previous = 350;
  if(lvl === 5) previous = 600;

  const next = thresholds[lvl];

  let current = game.xp - previous;

  let required = next - previous;

  if(lvl === 5){

    current = 1000;
    required = 1000;

  }

  let percent =
    Math.min(
      100,
      (current / required) * 100
    );

  document.getElementById(
    "xpBar"
  ).style.width = percent + "%";

  document.getElementById(
    "xpText"
  ).innerText =
    game.xp + " XP";

  document.getElementById(
    "levelBadge"
  ).innerText =
    "Level " + lvl + " Learner";

  document.getElementById(
    "rank"
  ).innerText =
    levelName();

  document.getElementById(
    "streak"
  ).innerText =
    game.streak;

  document.getElementById(
    "skillPoints"
  ).innerText =
    game.skillPoints;


  /* UNLOCKS */

  if(lvl >= 3){

    document
      .getElementById("advancedSkill")
      .classList.remove("locked");

  }

  if(lvl >= 4){

    document
      .getElementById("businessSkill")
      .classList.remove("locked");

  }

  if(lvl >= 3){

    document
      .getElementById("local")
      .classList.add("unlocked");

  }


  updateAchievements();

  document.getElementById(
    "selectedPath"
  ).innerText =
    game.path
      ? "🎯 Current route: " + game.path
      : "No route selected yet.";

}


/* =========================
   DAILY QUESTS
========================= */

function completeQuest(type,xp){

  if(game.completed.includes(type)){

    notify(
      "✓ Quest already completed today."
    );

    return;

  }

  game.completed.push(type);

  game.streak++;

  addXP(xp);

}


/* =========================
   MISSIONS
========================= */

function mission(id,xp){

  if(game.missions.includes(id)){

    notify(
      "✓ Mission already completed."
    );

    return;

  }

  game.missions.push(id);

  addXP(xp);

}


/* =========================
   POSTS
========================= */

function addPost(){

  const input =
    document.getElementById("post");

  const text =
    input.value.trim();

  if(!text) return;


  const div =
    document.createElement("div");

  div.className="post";

  div.innerHTML = `

    <strong>🧠 Your Insight</strong>

    <p class="small">
      ${escapeHTML(text)}
    </p>

  `;


  document
    .getElementById("feedPosts")
    .prepend(div);

  input.value="";

  addXP(10);

}


/* =========================
   PROOF
========================= */

function submitProof(){

  const input =
    document.getElementById("proof");

  const text =
    input.value.trim();

  if(!text) return;


  game.proofs.push(text);

  const list =
    document.getElementById("proofList");


  const item =
    document.createElement("div");

  item.className="achievement";

  item.innerHTML =
    "🏅 " + escapeHTML(text);


  list.prepend(item);

  input.value="";

  addXP(20);

}


/* =========================
   PATH
========================= */

function selectPath(type){

  if(
    type === "Local Business"
    &&
    level() < 3
  ){

    notify(
      "🔒 Reach Level 3 to unlock this path."
    );

    return;

  }


  game.path = type;

  save();

  document
    .querySelectorAll(".path")
    .forEach(
      p => p.classList.remove("selected")
    );


  if(type === "Service")
    document
      .getElementById("service")
      .classList.add("selected");

  if(type === "Product")
    document
      .getElementById("product")
      .classList.add("selected");

  if(type === "Local Business")
    document
      .getElementById("local")
      .classList.add("selected");


  notify(
    "🎯 " + type + " Path Selected"
  );

  update();

}


/* =========================
   AI COACH
========================= */

function ai(){

  const input =
    document
      .getElementById("aiInput")
      .value
      .toLowerCase();

  let response;


  if(input.includes("money")){

    response =
      "💰 Choose one useful skill, build one proof piece, then make one clear offer.";

  }

  else if(input.includes("job")){

    response =
      "💼 Build proof before collecting more certificates. Employers need evidence that you can perform.";

  }

  else if(input.includes("focus")){

    response =
      "🎯 Pick one mission. Remove competing tasks. Work until you create a visible result.";

  }

  else if(input.includes("business")){

    response =
      "🏗️ Start with a painful problem, create a small solution, test it, then improve it.";

  }

  else if(input.includes("learn")){

    response =
      "🧠 Learn → practice → produce → document → repeat.";

  }

  else{

    response =
      "⚡ Your next move: choose one small action that produces evidence.";

  }


  document.getElementById(
    "aiOut"
  ).innerText = response;

}


/* =========================
   ACHIEVEMENTS
========================= */

function updateAchievements(){

  const box =
    document.getElementById(
      "achievements"
    );

  box.innerHTML="";


  const achievements = [

    {
      name:"First Steps",
      icon:"👣",
      unlocked:game.xp >= 15
    },

    {
      name:"100 XP Earned",
      icon:"⭐",
      unlocked:game.xp >= 100
    },

    {
      name:"Mission Complete",
      icon:"⚔️",
      unlocked:game.missions.length >= 1
    },

    {
      name:"Proof Builder",
      icon:"📜",
      unlocked:game.proofs.length >= 1
    },

    {
      name:"Level 3 Builder",
      icon:"🏗️",
      unlocked:level() >= 3
    },

    {
      name:"Opportunity Architect",
      icon:"👑",
      unlocked:level() >= 5
    }

  ];


  achievements.forEach(a=>{

    const div =
      document.createElement("div");

    div.className =
      "achievement "
      + (a.unlocked ? "" : "locked");


    div.innerHTML =
      a.icon +
      " <strong>" +
      a.name +
      "</strong>" +
      (
        a.unlocked
        ? " ✓"
        : " 🔒"
      );


    box.appendChild(div);

  });

}


/* =========================
   SECURITY
========================= */

function escapeHTML(text){

  const div =
    document.createElement("div");

  div.textContent = text;

  return div.innerHTML;

}


/* =========================
   RESET
========================= */

function resetGame(){

  if(
    !confirm(
      "Reset all career quest progress?"
    )
  ) return;


  localStorage.removeItem(
    "elevateGame"
  );

  location.reload();

}


/* =========================
   INITIALIZE
========================= */

update();


if(game.path){

  selectPath(game.path);

}

