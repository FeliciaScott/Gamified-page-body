  </div>

</div>


<!-- CENTER -->

<div>

  <div class="hero">

    <h1>⚔️ Your Career Quest</h1>

    <p>
      Don't just consume information. Turn knowledge into skills,
      skills into proof, and proof into opportunities.
    </p>

  </div>


  <!-- MISSIONS -->

  <div class="card" id="missions">

    <h3>🗺️ Mission Board</h3>

    <p class="small">
